{
  "name": "@accounting/pantry",
  "version": "0.2.7",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "build": "rer build",
    "dev": "rer dev",
    "preview": "rer preview",
    "typecheck": "tsc --build --incremental",
    "test:typecheck": "node --test tests/incremental-typecheck.test.mjs",
    "verify": "rer verify",
    "setup": "rer setup",
    "deploy": "rer deploy",
    "test:runtime": "node tests/runtime.mjs",
    "onboard": "node scripts/install.mjs",
    "build:app": "vite build",
    "verify:app": "node scripts/verify.mjs",
    "reset": "rer reset",
    "export": "rer export",
    "import": "rer import",
    "release": "rer release",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "test:pantry": "node --test --test-concurrency=1 tests/api/*.test.mjs",
    "test:app": "node --test tests/app/*.test.mjs",
    "test:restore": "node --test tests/restore/*.test.mjs",
    "verify:release": "node tests/release/verify.mjs",
    "agent": "node scripts/pantry-agent.mjs",
    "test:site": "node --test tests/site/*.test.mjs",
    "hosted-backup": "node scripts/hosted-backup.mjs",
    "delivery:spec": "node scripts/build-deployment-spec.mjs",
    "check:deployment-spec": "node scripts/build-deployment-spec.mjs --check"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "hono": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.63.0",
    "@runeditrun/rer": "0.2.80",
    "@types/node": "22.18.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.1",
    "marked": "18.0.14",
    "miniflare": "5.20260907.0-alpha",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "undici": "7.29.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "license": "MIT",
  "repository": "https://github.com/just-every/run-pantry"
}
