{
  "schema": 1,
  "project": {
    "schema": 1,
    "projectId": "just-every/run-pantry",
    "name": "Pantry",
    "sourceRepository": "https://github.com/just-every/run-pantry",
    "license": "MIT",
    "deployment": {
      "target": "cloudflare-workers",
      "artifactFile": "rer-worker-artifact.json"
    },
    "operations": {
      "setup": "pnpm install --frozen-lockfile && pnpm exec rer install",
      "build": "pnpm run build",
      "verify": "pnpm exec rer check --profile first-party && pnpm run verify && pnpm run check:deployment-spec",
      "artifact": "node scripts/delivery/base/cli.mjs artifact --config packaging.json",
      "recovery": "Follow docs/backup.md and OPERATIONS.md. Stop writes and scheduled work; retain exact source, private settings, deployment receipts and applied migration bytes. For hosted books run node scripts/hosted-backup.mjs with the private environment file; rer export saves only local books. Restore into fresh empty resources, establish the owner, compare restored books and attachments, then verify owner workflows before switching traffic. Never reset populated books to apply an update."
    },
    "verification": {
      "sensitivePaths": [
        "src/auth.server.ts",
        "src/base/**",
        "src/pantry/**",
        "scripts/installer/**",
        "scripts/delivery/**",
        "rer-setup.json",
        "packaging.json"
      ],
      "migrationDirectories": [
        "migrations/core"
      ],
      "guidanceFiles": [
        "CONTRACT.md",
        "README.md",
        "OPERATIONS.md"
      ],
      "testPatterns": [
        "tests/api/*.test.mjs",
        "tests/app/*.test.mjs",
        "tests/restore/*.test.mjs",
        "tests/site/*.test.mjs"
      ]
    }
  },
  "managed": {
    "workflowRef": "runeditrun/delivery/.github/workflows/trusted-build.yml@86c8b37399c901bffd9a240dbd1148a65ec83b34",
    "artifactFile": "rer-worker-artifact.json",
    "buildProfile": "project",
    "verificationProfiles": [
      "full"
    ]
  },
  "edition": {
    "manifestFile": "edition.json",
    "componentId": "just-every/pantry"
  },
  "setup": {
    "manifestFile": "rer-setup.json"
  },
  "artifact": {
    "specInputs": {
      "publicVariableNames": [
        "AUTH_ORIGIN",
        "AUTH_LOCAL",
        "OWNER_EMAIL",
        "MAIL_PROVIDER",
        "MAIL_FROM",
        "MAIL_RELAY_URL",
        "MAIL_ACCOUNT_ID",
        "IDENTITY_PROVIDER",
        "PANTRY_ACCOUNTANT_CLIENTS",
        "RER_MANAGEMENT_ORIGIN",
        "RER_INSTALLATION_ID",
        "RER_OWNER_CLAIM_ISSUER",
        "RER_OWNER_CLAIM_INSTALLATION_ID",
        "RER_OWNER_CLAIM_APP_ORIGIN",
        "RER_OWNER_CLAIM_PUBLIC_KEYS",
        "RER_DEPLOY_SOURCE",
        "RER_DEPLOY_FINGERPRINT",
        "PLAID_ENV",
        "PLAID_REDIRECT_URI",
        "GUSTO_ENV"
      ],
      "secretNames": [
        "SESSION_SECRET",
        "INSTALLATION_KEY",
        "SETUP_TOKEN"
      ],
      "optionalSecretNames": [
        "PANTRY_OIDC_PROVIDERS",
        "OIDC_TRANSACTION_SECRET",
        "MAIL_API_KEY",
        "PLAID_CLIENT_ID",
        "PLAID_SECRET",
        "XERO_CLIENT_ID",
        "XERO_CLIENT_SECRET",
        "GUSTO_CLIENT_ID",
        "GUSTO_CLIENT_SECRET"
      ],
      "providerEffects": [
        "outbound-mail",
        "ai",
        "outbound-webhooks"
      ],
      "healthPath": "/health",
      "recovery": "Follow docs/backup.md and OPERATIONS.md. Stop writes and scheduled work; retain exact source, private settings, deployment receipts and applied migration bytes. For hosted books run node scripts/hosted-backup.mjs with the private environment file; rer export saves only local books. Restore into fresh empty resources, establish the owner, compare restored books and attachments, then verify owner workflows before switching traffic. Never reset populated books to apply an update.",
      "surfaces": {
        "app": {
          "path": "/",
          "originVariable": "AUTH_ORIGIN",
          "signIn": {
            "path": "/signin",
            "loginHint": false
          }
        }
      },
      "mail": {
        "providers": [
          "rer",
          "resend",
          "sendgrid",
          "cloudflare"
        ]
      }
    }
  }
}
