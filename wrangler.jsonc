{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "accounting-pantry",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "* * * * *",
      "*/30 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foundation",
      "database_id": "local-foundation-only",
      "migrations_dir": "migrations/core"
    }
  ],
  "vars": {
    "MAIL_PROVIDER": "",
    "MAIL_FROM": "",
    "MAIL_RELAY_URL": "",
    "MAIL_ACCOUNT_ID": ""
  },
  "r2_buckets": [
    {
      "binding": "PANTRY_BACKUPS",
      "bucket_name": "local-pantry-backups"
    },
    {
      "binding": "PANTRY_DOCUMENTS",
      "bucket_name": "local-pantry-documents"
    }
  ]
}
