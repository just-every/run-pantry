{
  "schemaVersion": 1,
  "id": "just-every/run-pantry",
  "toolchain": {
    "id": "runeditrun/edition-authoring",
    "version": "1.1.0"
  },
  "custody": {
    "repository": "https://github.com/just-every/run-pantry"
  },
  "components": [
    {
      "id": "just-every/pantry",
      "role": "edition",
      "source": {
        "kind": "local",
        "paths": [
          "src",
          "scripts",
          "tests",
          "migrations",
          "fixtures",
          "public",
          "docs"
        ],
        "origin": {
          "repository": "https://github.com/runeditrun/base",
          "revision": "4280971d7c0295b8a88c3e1179048efcbbe14f30",
          "path": ".",
          "paths": [
            "modules/delivery-producer/setup-manifest.mjs",
            "foundation/template/src/server.dev.ts"
          ]
        },
        "mappings": [
          {
            "path": "scripts/delivery/base/setup-manifest.mjs",
            "originPath": "modules/delivery-producer/setup-manifest.mjs"
          },
          {
            "path": "src/server.dev.ts",
            "originPath": "foundation/template/src/server.dev.ts"
          }
        ]
      }
    }
  ]
}
