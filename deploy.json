{
  "version": 1,
  "project": "accounting/pantry",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "originVar": "AUTH_ORIGIN",
  "vars": {
    "AUTH_LOCAL": "false"
  },
  "secrets": [
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "MAIL_API_KEY"
    },
    {
      "binding": "PLAID_CLIENT_ID",
      "environment": "PLAID_CLIENT_ID",
      "optional": true
    },
    {
      "binding": "PLAID_SECRET",
      "environment": "PLAID_SECRET",
      "optional": true
    },
    {
      "binding": "PLAID_ENV",
      "environment": "PLAID_ENV",
      "optional": true
    },
    {
      "binding": "PLAID_REDIRECT_URI",
      "environment": "PLAID_REDIRECT_URI",
      "optional": true
    },
    {
      "binding": "XERO_CLIENT_ID",
      "environment": "XERO_CLIENT_ID",
      "optional": true
    },
    {
      "binding": "XERO_CLIENT_SECRET",
      "environment": "XERO_CLIENT_SECRET",
      "optional": true
    },
    {
      "binding": "GUSTO_CLIENT_ID",
      "environment": "GUSTO_CLIENT_ID",
      "optional": true
    },
    {
      "binding": "GUSTO_CLIENT_SECRET",
      "environment": "GUSTO_CLIENT_SECRET",
      "optional": true
    },
    {
      "binding": "GUSTO_ENV",
      "environment": "GUSTO_ENV",
      "optional": true
    },
    {
      "binding": "MAIL_PROVIDER",
      "environment": "MAIL_PROVIDER"
    },
    {
      "binding": "MAIL_FROM",
      "environment": "MAIL_FROM"
    },
    {
      "binding": "MAIL_RELAY_URL",
      "environment": "MAIL_RELAY_URL",
      "optional": true
    },
    {
      "binding": "MAIL_ACCOUNT_ID",
      "environment": "MAIL_ACCOUNT_ID",
      "optional": true
    }
  ],
  "crons": [
    "*/30 * * * *"
  ],
  "platforms": [
    "workers",
    "container"
  ],
  "r2": [
    {
      "binding": "PANTRY_BACKUPS"
    },
    {
      "binding": "PANTRY_DOCUMENTS"
    }
  ]
}
