  "nonGoals": [
    "Paying bills or moving money from Pantry",
    "Tax filing or tax advice",
    "Running payroll (Gusto runs it; Pantry books it)",
    "Multi-currency",
    "Multi-entity consolidation",
    "Inventory valuation",
    "Depreciation automation",
    "Advanced revenue recognition",
    "A model account held by Pantry (receipts and answers are read with the installation's own AI key)"
  ],
  "externals": [
    {
      "id": "cloudflare",
      "required": true,
      "why": "Worker hosting",
      "data": [
        "HTTP requests"
      ],
      "adapters": []
    },
    {
      "id": "mail-provider",
      "required": false,
      "why": "A hosted Pantry emails sign-in links, invitations, invoices, reminders and its questions through the owner's own Resend or SendGrid account; Pantry on your own computer sends no email.",
      "data": [
        "Recipient email address",
        "Invoice PDF and customer-page link",
        "Sign-in and invitation links"
      ],
      "adapters": []
    },
    {
      "id": "plaid",
      "required": false,
      "why": "Live bank and card feeds with the owner's own Plaid keys; statement files work without it.",
      "data": [
        "Bank and card transactions",
        "Account names and last four digits"
      ],
      "adapters": []
    },
    {
      "id": "stripe",
      "required": false,
      "why": "Card payment from the invoice link (ACH bank debit for a US Stripe account) and payouts split into sales, fees and refunds, with the business's own Stripe key.",
      "data": [
        "Invoice amount and number",
        "Payments, payouts and balance transactions"
      ],
      "adapters": []
    },
    {
      "id": "gusto",
      "required": false,
      "why": "Payrolls posted as one balanced entry, through the owner's own Gusto developer app.",
      "data": [
        "Payroll totals by category"
      ],
      "adapters": []
    },
    {
      "id": "xero",
      "required": false,
      "why": "Move-in from Xero with attachments, through the owner's own Xero app.",
      "data": [
        "Chart, contacts, open invoices and bills, attachments"
      ],
      "adapters": []
    },
    {
      "id": "ai-provider",
      "required": false,
      "why": "Reading receipts and the owner's own words in answers, with the installation's own key; without one, details are typed in.",
      "data": [
        "Receipt images and text",
        "The owner's answer text"
      ],
      "adapters": []
    }
  ],
  "env": [],
  "deploy": {
    "healthPath": "/health",
    "publicPaths": [
      "/",
      "/health",
      "/signin"
    ],
    "notes": "Native owner sessions guard /app; unknown paths return real 404s; local runs send no email."
  },
  "extensionPoints": {
